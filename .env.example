# Copy to .env and fill in. .env is ignored by Git.

# Optional MongoDB Atlas storage for removal history.
# Leave MONGODB_URI empty to run without a database.
MONGODB_URI=mongodb+srv://<username>:<db_password>@<cluster>.mongodb.net/
# Raw password; it is URL-encoded and substituted for <db_password> above.
MONGODB_PASSWORD=
MONGODB_DB=cutout_studio
